# Proxy Listener & Incoming Authentication (for Looker / Legacy JDBC)
PROXY_LISTEN_ADDR=":14330"
PROXY_USER="looker_user"
PROXY_PASSWORD="your-strong-looker-password"

# Microsoft Fabric Data Warehouse Upstream Connection Settings
FABRIC_HOST="your-workspace-guid.datawarehouse.fabric.microsoft.com"
FABRIC_PORT=1433
FABRIC_DATABASE="your_warehouse_or_lakehouse_name"
FABRIC_TABLE="optional_schema.optional_table_name"

# Microsoft Entra ID (Azure AD) Service Principal Credentials
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET="your-service-principal-client-secret"
